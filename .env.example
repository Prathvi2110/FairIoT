# Copy to .env for local development. Replace both development-only values before deployment.
POSTGRES_DB=fairiot
POSTGRES_USER=fairiot
POSTGRES_PASSWORD=local-only-change-this-password
DATABASE_URL=postgresql+psycopg://fairiot:local-only-change-this-password@localhost:5432/fairiot
JWT_SECRET_KEY=local-only-change-this-with-a-long-random-secret-before-deployment
ACCESS_TOKEN_MINUTES=60
MAX_UPLOAD_MB=15
FRONTEND_URL=http://localhost:3000

# Optional password-reset email transport. Reset links are not sent unless SMTP_HOST and SMTP_FROM_EMAIL are configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
